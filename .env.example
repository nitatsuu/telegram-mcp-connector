# Copy to .data/.env (or just run `telegram-mcp-connector login`, which writes it for you).
# Get these at https://my.telegram.org -> API development tools.
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Write access is OFF by default. When on, it enables send_message and mark_read.
TG_ALLOW_WRITE=false
# Chats send_message may post to: numeric ids and/or @usernames, comma-separated.
# "me" = Saved Messages. "*" = any chat (not recommended).
TG_SEND_ALLOWLIST=me

# Where the session and this config live. Defaults to <project>/.data
# TG_DATA_DIR=/absolute/path
